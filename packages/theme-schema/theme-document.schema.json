{
  "$defs": {
    "Brand": {
      "additionalProperties": false,
      "properties": {
        "favicon_url": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Favicon Url"
        },
        "logo_dark_url": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logo Dark Url"
        },
        "logo_height": {
          "default": 40,
          "maximum": 120,
          "minimum": 16,
          "title": "Logo Height",
          "type": "integer"
        },
        "logo_url": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logo Url"
        }
      },
      "title": "Brand",
      "type": "object"
    },
    "CollectionLayout": {
      "additionalProperties": false,
      "properties": {
        "columns_desktop": {
          "default": 4,
          "enum": [
            3,
            4,
            5
          ],
          "title": "Columns Desktop",
          "type": "integer"
        },
        "columns_mobile": {
          "default": 2,
          "enum": [
            1,
            2
          ],
          "title": "Columns Mobile",
          "type": "integer"
        },
        "default_sort": {
          "default": "newest",
          "enum": [
            "newest",
            "price_asc",
            "price_desc",
            "popular"
          ],
          "title": "Default Sort",
          "type": "string"
        },
        "filters": {
          "default": "sidebar",
          "enum": [
            "sidebar",
            "drawer"
          ],
          "title": "Filters",
          "type": "string"
        }
      },
      "title": "CollectionLayout",
      "type": "object"
    },
    "CustomPage": {
      "additionalProperties": false,
      "properties": {
        "published": {
          "default": true,
          "title": "Published",
          "type": "boolean"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "title": "Sections",
          "type": "array"
        },
        "seo": {
          "$ref": "#/$defs/Seo",
          "default": {
            "description": {
              "bn": "",
              "en": ""
            },
            "title": {
              "bn": "",
              "en": ""
            }
          }
        },
        "slug": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,58}[a-z0-9])?$",
          "title": "Slug",
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "slug",
        "title"
      ],
      "title": "CustomPage",
      "type": "object"
    },
    "Footer": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/FooterColumn"
          },
          "maxItems": 4,
          "title": "Columns",
          "type": "array"
        },
        "copyright": {
          "$ref": "#/$defs/Text",
          "default": {
            "bn": "",
            "en": ""
          }
        },
        "show_payment_icons": {
          "default": true,
          "title": "Show Payment Icons",
          "type": "boolean"
        },
        "social": {
          "additionalProperties": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "facebook",
              "instagram",
              "youtube",
              "tiktok",
              "linkedin"
            ]
          },
          "title": "Social",
          "type": "object"
        }
      },
      "title": "Footer",
      "type": "object"
    },
    "FooterColumn": {
      "additionalProperties": false,
      "properties": {
        "links": {
          "items": {
            "$ref": "#/$defs/Link"
          },
          "maxItems": 10,
          "title": "Links",
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "title"
      ],
      "title": "FooterColumn",
      "type": "object"
    },
    "Header": {
      "additionalProperties": false,
      "properties": {
        "logo_position": {
          "default": "left",
          "enum": [
            "left",
            "center"
          ],
          "title": "Logo Position",
          "type": "string"
        },
        "menu": {
          "items": {
            "$ref": "#/$defs/MenuItem"
          },
          "maxItems": 12,
          "title": "Menu",
          "type": "array"
        },
        "show_search": {
          "default": true,
          "title": "Show Search",
          "type": "boolean"
        },
        "sticky": {
          "default": true,
          "title": "Sticky",
          "type": "boolean"
        }
      },
      "title": "Header",
      "type": "object"
    },
    "Layouts": {
      "additionalProperties": false,
      "properties": {
        "footer": {
          "$ref": "#/$defs/Footer",
          "default": {
            "columns": [],
            "copyright": {
              "bn": "",
              "en": ""
            },
            "show_payment_icons": true,
            "social": {}
          }
        },
        "header": {
          "$ref": "#/$defs/Header",
          "default": {
            "logo_position": "left",
            "menu": [],
            "show_search": true,
            "sticky": true
          }
        }
      },
      "title": "Layouts",
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "properties": {
        "href": {
          "maxLength": 300,
          "title": "Href",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Text",
          "default": {
            "bn": "",
            "en": ""
          }
        }
      },
      "required": [
        "href"
      ],
      "title": "Link",
      "type": "object"
    },
    "MenuItem": {
      "additionalProperties": false,
      "properties": {
        "children": {
          "items": {
            "$ref": "#/$defs/Link"
          },
          "maxItems": 12,
          "title": "Children",
          "type": "array"
        },
        "href": {
          "maxLength": 300,
          "title": "Href",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "label",
        "href"
      ],
      "title": "MenuItem",
      "type": "object"
    },
    "Palette": {
      "additionalProperties": false,
      "properties": {
        "accent": {
          "pattern": "^(25[0-5]|2[0-4]\\d|1?\\d?\\d) (25[0-5]|2[0-4]\\d|1?\\d?\\d) (25[0-5]|2[0-4]\\d|1?\\d?\\d)$",
          "title": "Accent",
          "type": "string"
        },
        "bg": {
          "pattern": "^(25[0-5]|2[0-4]\\d|1?\\d?\\d) (25[0-5]|2[0-4]\\d|1?\\d?\\d) (25[0-5]|2[0-4]\\d|1?\\d?\\d)$",
          "title": "Bg",
          "type": "string"
        },
        "border": {
          "pattern": "^(25[0-5]|2[0-4]\\d|1?\\d?\\d) (25[0-5]|2[0-4]\\d|1?\\d?\\d) (25[0-5]|2[0-4]\\d|1?\\d?\\d)$",
          "title": "Border",
          "type": "string"
        },
        "danger": {
          "pattern": "^(25[0-5]|2[0-4]\\d|1?\\d?\\d) (25[0-5]|2[0-4]\\d|1?\\d?\\d) (25[0-5]|2[0-4]\\d|1?\\d?\\d)$",
          "title": "Danger",
          "type": "string"
        },
        "fg": {
          "pattern": "^(25[0-5]|2[0-4]\\d|1?\\d?\\d) (25[0-5]|2[0-4]\\d|1?\\d?\\d) (25[0-5]|2[0-4]\\d|1?\\d?\\d)$",
          "title": "Fg",
          "type": "string"
        },
        "muted": {
          "pattern": "^(25[0-5]|2[0-4]\\d|1?\\d?\\d) (25[0-5]|2[0-4]\\d|1?\\d?\\d) (25[0-5]|2[0-4]\\d|1?\\d?\\d)$",
          "title": "Muted",
          "type": "string"
        },
        "primary": {
          "pattern": "^(25[0-5]|2[0-4]\\d|1?\\d?\\d) (25[0-5]|2[0-4]\\d|1?\\d?\\d) (25[0-5]|2[0-4]\\d|1?\\d?\\d)$",
          "title": "Primary",
          "type": "string"
        },
        "primary-fg": {
          "pattern": "^(25[0-5]|2[0-4]\\d|1?\\d?\\d) (25[0-5]|2[0-4]\\d|1?\\d?\\d) (25[0-5]|2[0-4]\\d|1?\\d?\\d)$",
          "title": "Primary-Fg",
          "type": "string"
        },
        "secondary": {
          "pattern": "^(25[0-5]|2[0-4]\\d|1?\\d?\\d) (25[0-5]|2[0-4]\\d|1?\\d?\\d) (25[0-5]|2[0-4]\\d|1?\\d?\\d)$",
          "title": "Secondary",
          "type": "string"
        },
        "success": {
          "pattern": "^(25[0-5]|2[0-4]\\d|1?\\d?\\d) (25[0-5]|2[0-4]\\d|1?\\d?\\d) (25[0-5]|2[0-4]\\d|1?\\d?\\d)$",
          "title": "Success",
          "type": "string"
        },
        "surface": {
          "pattern": "^(25[0-5]|2[0-4]\\d|1?\\d?\\d) (25[0-5]|2[0-4]\\d|1?\\d?\\d) (25[0-5]|2[0-4]\\d|1?\\d?\\d)$",
          "title": "Surface",
          "type": "string"
        }
      },
      "required": [
        "primary",
        "primary-fg",
        "secondary",
        "accent",
        "bg",
        "surface",
        "fg",
        "muted",
        "border",
        "danger",
        "success"
      ],
      "title": "Palette",
      "type": "object"
    },
    "ProductLayout": {
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "items": {
            "enum": [
              "title",
              "price",
              "variants",
              "add_to_cart",
              "vendor_card",
              "delivery",
              "description",
              "specs",
              "questions",
              "reviews",
              "related"
            ],
            "type": "string"
          },
          "maxItems": 11,
          "minItems": 3,
          "title": "Blocks",
          "type": "array"
        },
        "gallery": {
          "default": "thumbnails_bottom",
          "enum": [
            "thumbnails_left",
            "thumbnails_bottom",
            "grid"
          ],
          "title": "Gallery",
          "type": "string"
        }
      },
      "title": "ProductLayout",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "hidden": {
          "default": false,
          "title": "Hidden",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[a-z0-9]{6,24}$",
          "title": "Id",
          "type": "string"
        },
        "settings": {
          "additionalProperties": true,
          "title": "Settings",
          "type": "object"
        },
        "type": {
          "enum": [
            "announcement_bar",
            "hero_slider",
            "image_banner",
            "banner_grid",
            "category_grid",
            "product_carousel",
            "product_grid",
            "flash_sale",
            "campaign_strip",
            "brand_strip",
            "top_vendors",
            "featured_vendor",
            "rich_text",
            "image_with_text",
            "faq",
            "testimonials",
            "newsletter",
            "trust_badges",
            "video_embed",
            "spacer"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "Section",
      "type": "object"
    },
    "Seo": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "$ref": "#/$defs/Text",
          "default": {
            "bn": "",
            "en": ""
          }
        },
        "title": {
          "$ref": "#/$defs/Text",
          "default": {
            "bn": "",
            "en": ""
          }
        }
      },
      "title": "Seo",
      "type": "object"
    },
    "Templates": {
      "additionalProperties": false,
      "properties": {
        "category_top": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "title": "Category Top",
          "type": "array"
        },
        "collection_layout": {
          "$ref": "#/$defs/CollectionLayout",
          "default": {
            "columns_desktop": 4,
            "columns_mobile": 2,
            "default_sort": "newest",
            "filters": "sidebar"
          }
        },
        "home": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "title": "Home",
          "type": "array"
        },
        "product_bottom": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "title": "Product Bottom",
          "type": "array"
        },
        "product_layout": {
          "$ref": "#/$defs/ProductLayout",
          "default": {
            "blocks": [
              "title",
              "price",
              "variants",
              "add_to_cart",
              "vendor_card",
              "delivery",
              "description",
              "specs",
              "questions",
              "reviews",
              "related"
            ],
            "gallery": "thumbnails_bottom"
          }
        }
      },
      "title": "Templates",
      "type": "object"
    },
    "Text": {
      "additionalProperties": false,
      "description": "Bilingual short text. Plain text only; rendered escaped.",
      "properties": {
        "bn": {
          "default": "",
          "maxLength": 300,
          "title": "Bn",
          "type": "string"
        },
        "en": {
          "default": "",
          "maxLength": 300,
          "title": "En",
          "type": "string"
        }
      },
      "title": "Text",
      "type": "object"
    },
    "Tokens": {
      "additionalProperties": false,
      "properties": {
        "button_style": {
          "default": "solid",
          "enum": [
            "solid",
            "outline",
            "pill"
          ],
          "title": "Button Style",
          "type": "string"
        },
        "colors": {
          "$ref": "#/$defs/Palette"
        },
        "dark": {
          "$ref": "#/$defs/Palette"
        },
        "density": {
          "default": "comfortable",
          "enum": [
            "compact",
            "comfortable"
          ],
          "title": "Density",
          "type": "string"
        },
        "font_body": {
          "default": "inter-hind-siliguri",
          "enum": [
            "inter-hind-siliguri",
            "poppins-noto-sans-bengali",
            "lora-noto-serif-bengali",
            "roboto-baloo-da-2",
            "system"
          ],
          "title": "Font Body",
          "type": "string"
        },
        "font_heading": {
          "default": "inter-hind-siliguri",
          "enum": [
            "inter-hind-siliguri",
            "poppins-noto-sans-bengali",
            "lora-noto-serif-bengali",
            "roboto-baloo-da-2",
            "system"
          ],
          "title": "Font Heading",
          "type": "string"
        },
        "radius": {
          "default": "0.5rem",
          "enum": [
            "0rem",
            "0.25rem",
            "0.5rem",
            "0.75rem",
            "1rem",
            "9999px"
          ],
          "title": "Radius",
          "type": "string"
        }
      },
      "required": [
        "colors",
        "dark"
      ],
      "title": "Tokens",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "v1: tokens + brand (Phase 4). v2 adds layouts, templates, custom pages, custom CSS (Phase 8).\nv1 documents validate unchanged; missing v2 parts take defaults.",
  "properties": {
    "brand": {
      "$ref": "#/$defs/Brand",
      "default": {
        "favicon_url": null,
        "logo_dark_url": null,
        "logo_height": 40,
        "logo_url": null
      }
    },
    "custom_css": {
      "default": "",
      "maxLength": 50000,
      "title": "Custom Css",
      "type": "string"
    },
    "layouts": {
      "$ref": "#/$defs/Layouts",
      "default": {
        "footer": {
          "columns": [],
          "copyright": {
            "bn": "",
            "en": ""
          },
          "show_payment_icons": true,
          "social": {}
        },
        "header": {
          "logo_position": "left",
          "menu": [],
          "show_search": true,
          "sticky": true
        }
      }
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/CustomPage"
      },
      "maxItems": 30,
      "title": "Pages",
      "type": "array"
    },
    "preset": {
      "pattern": "^[a-z][a-z0-9-]{1,40}$",
      "title": "Preset",
      "type": "string"
    },
    "schema_version": {
      "default": 2,
      "enum": [
        1,
        2
      ],
      "title": "Schema Version",
      "type": "integer"
    },
    "templates": {
      "$ref": "#/$defs/Templates",
      "default": {
        "category_top": [],
        "collection_layout": {
          "columns_desktop": 4,
          "columns_mobile": 2,
          "default_sort": "newest",
          "filters": "sidebar"
        },
        "home": [],
        "product_bottom": [],
        "product_layout": {
          "blocks": [
            "title",
            "price",
            "variants",
            "add_to_cart",
            "vendor_card",
            "delivery",
            "description",
            "specs",
            "questions",
            "reviews",
            "related"
          ],
          "gallery": "thumbnails_bottom"
        }
      }
    },
    "tokens": {
      "$ref": "#/$defs/Tokens"
    }
  },
  "required": [
    "preset",
    "tokens"
  ],
  "title": "ThemeDocument",
  "type": "object"
}
