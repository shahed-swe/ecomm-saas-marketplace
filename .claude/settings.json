{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npm run *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(alembic upgrade *)",
      "Bash(alembic revision *)",
      "Bash(alembic downgrade *)",
      "Bash(docker compose up *)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Read(**)",
      "Edit(apps/**)",
      "Edit(infra/**)",
      "Edit(.claude/**)",
      "Edit(plan/**)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(alembic downgrade base)",
      "Bash(docker compose down -v)",
      "Bash(psql *production*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/secrets/**)",
      "Edit(./.env)",
      "Edit(**/*.pem)"
    ]
  },
  "env": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_FILE_PATHS\" | grep -q '\\.py$'; then ruff format $CLAUDE_FILE_PATHS && ruff check --fix $CLAUDE_FILE_PATHS; fi"
          },
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_FILE_PATHS\" | grep -qE '\\.(ts|tsx)$'; then pnpm -C apps/web exec prettier --write $CLAUDE_FILE_PATHS; fi"
          }
        ]
      }
    ]
  }
}
