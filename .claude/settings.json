{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npm run *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(alembic upgrade *)",
      "Bash(alembic revision *)",
      "Bash(alembic downgrade *)",
      "Bash(docker compose up *)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Read(**)",
      "Edit(apps/**)",
      "Edit(infra/**)",
      "Edit(.claude/**)",
      "Edit(plan/**)",
      "Edit(mobile/**)",
      "Edit(packages/**)",
      "Edit(docs/**)",
      "Edit(.github/**)",
      "Bash(uv run:*)",
      "Bash(make:*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(alembic downgrade base)",
      "Bash(docker compose down -v)",
      "Bash(psql *production*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/secrets/**)",
      "Edit(./.env)",
      "Edit(**/*.pem)"
    ]
  },
  "env": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in *.py) (cd apps/api && uv run ruff format \"$f\" && uv run ruff check --fix \"$f\") ;; *.ts|*.tsx) pnpm -C apps/web exec prettier --write \"$f\" ;; *.dart) dart format \"$f\" ;; esac; } || true"
          }
        ]
      }
    ]
  }
}